---
import { sanityClient } from "sanity:client";
import PageContainer from "../../layout/PageContainer.astro";
import type {
    ColorPicker,
    OntopCover,
    SiteNavigators,
} from "../../../studio-lorika-ontop/sanity.types";
import OntopCoverContent from "../../content/OntopCoverContent.astro";

const SITE_NAVIGATORS_QUERY = `
    *[_type == "siteNavigators" && lang == "it"]`;
const siteNavigators = await sanityClient.fetch<SiteNavigators[]>(
    SITE_NAVIGATORS_QUERY,
);

const COLOR_PICKER_QUERY = `
    *[_type == "colorPicker" && lang == "it"]`;
const colorPickerData =
    await sanityClient.fetch<ColorPicker[]>(COLOR_PICKER_QUERY);

const ONTOP_COVER_QUERY = `*[_type == "ontopCover" && lang == "it"]`;
const ontopCoverData =
    await sanityClient.fetch<OntopCover[]>(ONTOP_COVER_QUERY);
---

<PageContainer
    seo={ontopCoverData[0].seo!}
    lang="it"
    siteNavigators={siteNavigators[0]}
>
    <OntopCoverContent
        ontopCoverData={ontopCoverData[0]}
        colorPickerData={colorPickerData[0]}
    />
</PageContainer>
