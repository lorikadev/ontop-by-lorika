---
import './early-access.css'
---
<!-- PRIORTY ACCESS DIALOG -->
<dialog id="priority-access-dialog">
  <div class="dialog-header p-1">
    <button
      class="button red"
      commandfor="priority-access-dialog"
      command="close"
    >
      x
    </button>
  </div>
  <div class="dialog-body p-1">
    <p>
      Your area is not yet covered by the service. We don't currently ship to
      your region, but we're expanding rapidly.
      <br />
      Join the priority list to be the first to know when the service is available
      in your area.
    </p>
    <form class="mt-1" id="subscribe-form">
      <div class="input-button-wrapper">
        <input placeholder="E-MAIL" type="email" name="email" required />
        <button class="button primary" type="submit">join the list</button>
      </div>
      <small>
        <i>
          By clicking on "join the list" you accept ours
          <a target="_blank" href="/it/privacy">privacy policy</a>
        </i>
      </small>
    </form>
  </div>
</dialog>

<!-- SUBSCRIBE FORM SCRIPT -->
<script is:inline>
  const subscribeForm = document.getElementById("subscribe-form");
  const subscribeInputs = subscribeForm.querySelectorAll("button, input");
  const dialog = document.getElementById("priority-access-dialog");

  subscribeForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    //get data before the disable
    const data = Object.fromEntries(new FormData(subscribeForm));
    subscribeInputs.forEach((i) => (i.disabled = true));
    try {
      const endpointSubUrl = "/.netlify/functions/subscribe";

      const res = await fetch(endpointSubUrl, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(data),
      });

      if (dialog) dialog.close();

      if (!res.ok) {
        showModal("There was an error, try again later.", "error");
      } else {
        showModal("Thanks for your subscription!", "success");
        subscribeForm.reset();
      }
    } catch (error) {
      console.error(error);
    } finally {
      subscribeInputs.forEach((i) => (i.disabled = false));
    }
  });
</script>
