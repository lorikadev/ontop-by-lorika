---
import ColorPicker from "../components/ColorPicker/ColorPicker.astro";
import type {
  ColorPicker as ColorPickerCMS,
  OntopCover,
} from "../../studio-lorika-ontop/sanity.types";
import Accordion from "../components/Accordion/Accordion.astro";
import { cleanHtml } from "../scripts/globals/clean-html";

//SECTION - CSS
import "../../public/css/pages/ontop-cover.css";
import "../../public/libraries/splide-4.1.3/css/splide-default.min.css";
import { SHOP_REDIRECT_URL } from "../const";
//!SECTION - CSS

interface Props {
  colorPickerData: ColorPickerCMS;
  ontopCoverData: OntopCover;
}

let { colorPickerData, ontopCoverData } = Astro.props;
---

<div class="py-2" id="ontop-cover-page">
  <div class="container-small" id="product-wrapper">
    <!-- SECTION - PRODUCT GALLERY -->
    <div
      id="product-gallery"
      aria-label={ontopCoverData.gallerySectionAriaLabel}
    >
      <!-- MAIN IMAGE -->
      <div id="product-gallery-main-img" class="mb-1 show-till-mob"></div>
      <!-- SECONDARY IMAGES -->
      <div id="product-gallery-second-imgs" class="show-till-mob"></div>

      <!-- MOBILE GALLERY -->
      <section id="mobile-gallery" class="splide show-mob" aria-hidden>
        <div class="splide__track">
          <ul class="show-tab splide__list"></ul>
        </div>
      </section>
      <!-- MOBILE GALLERY THUMBNAILS -->
      <ul id="mobile-thumbnails" class="thumbnails show-mob"></ul>
    </div>
    <!-- !SECTION - PRODUCT GALLERY -->

    <!-- SECTION - PRODUCT INFO -->
    <section
      id="product-info"
      aria-label={ontopCoverData.productInfoSectionAriaLabel}
    >
      <!-- INFO IN ACCORDION -->
      <div id="product-info-data" class="card">
        {
          ontopCoverData.infos?.map((info, index) => (
            <Accordion
              title={info.title!}
              name="product-info-data"
              index={index}
            >
              <div slot="content" set:html={cleanHtml(info.htmlContent!)} />
            </Accordion>
          ))
        }
      </div>
      <!-- COLOR PICKER -->
      <div id="product-info-colorpicker-wrapper" class="card w-100">
        <ColorPicker
          colorPickerData={colorPickerData}
          id="product-info-colorpicker"
          layout="horizontal"
          displayLabel="hide"
        />
      </div>
      <!-- CTA -->
      <a
        class="button primary fs-15 w-100"
        aria-label={ontopCoverData.buyNowCta?.ariaLabel}
        href={SHOP_REDIRECT_URL}
        target="_blank"
      >
        {ontopCoverData.buyNowCta?.label}
      </a>
    </section>
    <!-- !SECTION - PRODUCT INFO -->
  </div>
</div>

<!-- ACCORDION SCRIPT -->
<script src="../scripts/globals/toggle-accordions.ts"></script>
<!-- load images corrisponding to curr ral and load splide for mobile gallery -->
<script src="../scripts/pages/ontop-cover/main.ts"></script>
