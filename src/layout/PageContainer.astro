---
import type {
  Seo,
  SiteNavigators,
} from "../../studio-lorika-ontop/sanity.types";
import Footer from "./Footer.astro";
import Navbar from "./Navbar.astro";

import "../../public/css/globals/reset.css";
import "../../public/css/globals/vars.css";
import "../../public/css/globals/font-size.css";
import "../../public/css/globals/global.css";
import "../../public/css/globals/spacing.css";
import "../../public/css/globals/navbar.css";
import "../../public/css/globals/footer.css";
import "../../public/css/globals/animations.css";
import { getLocaleFromLang } from "../scripts/globals/get-locale-from-lang";
import { urlFor } from "../scripts/globals/sanity-client";
import EarlyAccessEn from "../components/EarlyAccess/EarlyAccessEn.astro";
import EarlyAccessIt from "../components/EarlyAccess/EarlyAccessIt.astro";

const canonical = Astro.url.href;

interface Props {
  //SEO
  seo: Seo;
  //SITE NAVIGATORS (NAVBAR & FOOTER)
  siteNavigators: SiteNavigators;
  lang: string;
}

const {
  //SEO
  seo,
  //SITE NAVIGATORS (NAVBAR & FOOTER)
  siteNavigators,
  lang = "en",
} = Astro.props;

//NOTE - the images are required
const thumbnailUrl = urlFor(seo.shareImage?.asset?._ref!).url();
---

<!doctype html>
<html lang={lang}>
  <!-- IUBENDA -->
  <script
    type="text/javascript"
    src="https://embeds.iubenda.com/widgets/d27f647b-9e2f-42fd-9a32-00219f8c402f.js"
  ></script>

  <!-- SECTION - HEAD -->

  <!-- SECTION - FAVICONS -->
  <link
    rel="icon"
    type="image/png"
    sizes="96x96"
    href="/favicons/favicon-96x96.png"
  />
  <link
    rel="icon"
    href="/favicons/favicon.svg"
    type="image/svg+xml"
    sizes="any"
  />
  <link rel="icon" href="/favicons/favicon.ico" />
  <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png" />
  <link rel="manifest" href="/favicons/site.webmanifest" />
  <meta
    name="theme-color"
    content="#ffffff"
    media="(prefers-color-scheme: light)"
  />
  <meta
    name="theme-color"
    content="#0f172a"
    media="(prefers-color-scheme: dark)"
  />
  <!-- !SECTION - FAVICONS -->

  <!-- SECTION - META -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- SEO base -->
  <title>{seo.title}</title>
  <meta name="description" content={seo.description} />
  <meta name="robots" content={seo.robots} />
  {canonical && <link rel="canonical" href={canonical} />}

  <!-- Open Graph -->
  <meta property="og:title" content={seo.title} />
  <meta property="og:description" content={seo.description} />
  <meta property="og:type" content={seo.ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={thumbnailUrl} />
  <meta property="og:site_name" content={seo.ogSiteName} />
  <meta property="og:locale" content={getLocaleFromLang(lang)} />

  <!-- Twitter -->
  <meta name="twitter:card" content={seo.twitterCard} />
  <meta name="twitter:title" content={seo.title} />
  <meta name="twitter:description" content={seo.description} />
  <meta name="twitter:image" content={thumbnailUrl} />
  <!-- !SECTION - META -->

  <!-- SECTION - META + PIXEL + GA LOADER -->
  <script is:inline>
    function loadGA() {
      const s = document.createElement("script");
      s.src = "https://www.googletagmanager.com/gtag/js?id=G-GRKTDM70WC";
      s.async = true;
      document.head.appendChild(s);

      s.onload = () => {
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag("js", new Date());
        gtag("config", "G-GRKTDM70WC");
      };
    }

    function loadMetaPixel() {
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod
            ? n.callMethod.apply(n, arguments)
            : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = "2.0";
        n.queue = [];
        t = b.createElement(e);
        t.async = !0;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(
        window,
        document,
        "script",
        "https://connect.facebook.net/en_US/fbevents.js",
      );

      fbq("init", "1787167239334670");
      fbq("track", "PageView");
    }

    function initTracking() {
      const purposes = window._iub?.cs?.consent?.purposes || [];
      const hasAnalytics = purposes["3"] === true;
      const hasMarketing = purposes["4"] === true;

      if (hasAnalytics) loadGA();
      if (hasMarketing) loadMetaPixel();
    }

    window.addEventListener("load", () => {
      const interval = setInterval(() => {
        if (window._iub?.cs?.consent?.purposes) {
          clearInterval(interval);
          initTracking();
        }
      }, 1000);
    });
  </script>
  <!-- !SECTION - META + PIXEL + GA LOADER -->

  <!-- SECTION - BODY -->
  <body>
    <!-- SECTION - RESPONSE MODAL -->
    <!-- MODAL -->
    <div id="modal" class="modal hidden">
      <div id="modal-content" class="modal-content"></div>
    </div>
    <!-- HELPER SCRIPT -->
    <script is:inline>
      const modal = document.getElementById("modal");
      const modalContent = document.getElementById("modal-content");

      /**
       * @param message string of the content of the message
       * @param type type of message, currently works with error or success, fallback to green color
       */
      function showModal(message, type) {
        modalContent.textContent = message;

        //update the color of the content of the modal
        //default is green
        modalContent.classList.remove("green");
        modalContent.classList.remove("red");
        let respClass = "";
        switch (type) {
          case "error":
            respClass = "red";
            break;
          case "success":
          default:
            respClass = "green";
            break;
        }
        modalContent.classList.add(respClass);
        modal.classList.remove("hidden");

        // force reflow to fire animation
        requestAnimationFrame(() => {
          modal.classList.add("show");
        });

        //automatic disappear for the modal
        setTimeout(() => {
          modal.classList.remove("show");

          setTimeout(() => {
            modal.classList.add("hidden");
          }, 300);
        }, 2500);
      }
    </script>
    <!-- !SECTION - RESPONSE MODAL -->

    <!-- SECTION - INITIALIZERS -->
    <script src="../initializers/fire-color-inits.ts"></script>
    <script src="../scripts/globals/on-scroll-anim.ts"></script>
    <!-- !SECTION - INITIALIZERS -->
    <!-- NAVBAR -->
    <Navbar siteNavigators={siteNavigators} />
    <!-- MAIN -->
    <main style="position: relative;">
      <!-- PAGE CONTENT -->
      <slot />
    </main>
    <!-- FOOTER -->
    <Footer siteNavigators={siteNavigators} lang={lang} />
  </body>
  <!-- !SECTION - BODY -->
  {lang == "en" ? <EarlyAccessEn /> : <EarlyAccessIt />}
  <script>
    import { SHOP_REDIRECT_URL } from "../const";

    async function handleShopClick(e: Event) {
      e.preventDefault();

      const res = await fetch(SHOP_REDIRECT_URL);
      const data = await res.json();
      if (data.canUseShopify) window.open(data.url, "_blank");
      else {
        const dialogElem = document.getElementById(
          "priority-access-dialog",
        ) as HTMLDialogElement;
        if (dialogElem) dialogElem.showModal();
      }
    }

    const shopButtons = document.querySelectorAll(".shop-redirect");
    shopButtons.forEach((btn) => {
      (btn as HTMLElement).addEventListener("click", handleShopClick);
    });
  </script>
</html>
