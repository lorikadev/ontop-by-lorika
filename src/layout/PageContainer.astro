---
import type {
    Seo,
    SiteNavigators,
} from "../../studio-lorika-ontop/sanity.types";
import Footer from "./Footer.astro";
import Navbar from "./Navbar.astro";

import "../../public/css/globals/reset.css";
import "../../public/css/globals/vars.css";
import "../../public/css/globals/font-size.css";
import "../../public/css/globals/global.css";
import "../../public/css/globals/spacing.css";
import "../../public/css/globals/navbar.css";
import "../../public/css/globals/footer.css";
import "../../public/css/globals/animations.css";
import { getLocaleFromLang } from "../scripts/globals/get-locale-from-lang";
import { urlFor } from "../scripts/globals/sanity-client";

const canonical = Astro.url.href;

interface Props {
    //SEO
    seo: Seo;
    //SITE NAVIGATORS (NAVBAR & FOOTER)
    siteNavigators: SiteNavigators;
    lang: string;
}

const {
    //SEO
    seo,
    //SITE NAVIGATORS (NAVBAR & FOOTER)
    siteNavigators,
    lang = "en",
} = Astro.props;

//NOTE - the images are required
const thumbnailUrl = urlFor(seo.shareImage?.asset?._ref!).url();
---

<!doctype html>
<html lang={lang}>
    <!-- SECTION - HEAD -->
    <head>
        <!-- SECTION - Google Tag Manager -->
        <script is:inline>
            (function (w, d, s, l, i) {
                w[l] = w[l] || [];
                w[l].push({
                    "gtm.start": new Date().getTime(),
                    event: "gtm.js",
                });
                var f = d.getElementsByTagName(s)[0],
                    j = d.createElement(s),
                    dl = l != "dataLayer" ? "&l=" + l : "";
                j.async = true;
                j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
                f.parentNode.insertBefore(j, f);
            })(window, document, "script", "dataLayer", "GTM-WQMHXNJJ");
        </script>
        <!-- !SECTION - End Google Tag Manager -->

        <!-- SECTION - FAVICONS -->
        <link
            rel="icon"
            type="image/png"
            sizes="96x96"
            href="/favicons/favicon-96x96.png"
        />
        <link
            rel="icon"
            href="/favicons/favicon.svg"
            type="image/svg+xml"
            sizes="any"
        />
        <link rel="icon" href="/favicons/favicon.ico" />
        <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png" />
        <link rel="manifest" href="/favicons/site.webmanifest" />
        <meta
            name="theme-color"
            content="#ffffff"
            media="(prefers-color-scheme: light)"
        />
        <meta
            name="theme-color"
            content="#0f172a"
            media="(prefers-color-scheme: dark)"
        />
        <!-- !SECTION - FAVICONS -->

        <!-- SECTION - META -->
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <!-- SEO base -->
        <title>{seo.title}</title>
        <meta name="description" content={seo.description} />
        <meta name="robots" content={seo.robots} />
        {canonical && <link rel="canonical" href={canonical} />}

        <!-- Open Graph -->
        <meta property="og:title" content={seo.title} />
        <meta property="og:description" content={seo.description} />
        <meta property="og:type" content={seo.ogType} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={thumbnailUrl} />
        <meta property="og:site_name" content={seo.ogSiteName} />
        <meta property="og:locale" content={getLocaleFromLang(lang)} />

        <!-- Twitter -->
        <meta name="twitter:card" content={seo.twitterCard} />
        <meta name="twitter:title" content={seo.title} />
        <meta name="twitter:description" content={seo.description} />
        <meta name="twitter:image" content={thumbnailUrl} />
        <!-- !SECTION - META -->
    </head>
    <!-- !SECTION - HEAD -->
    <!-- SECTION - BODY -->
    <body>
        <!-- SECTION - Google Tag Manager (noscript) -->
        <noscript>
            <iframe
                src="https://www.googletagmanager.com/ns.html?id=GTM-WQMHXNJJ"
                height="0"
                width="0"
                style="display:none;visibility:hidden"></iframe>
        </noscript>
        <!-- !SECTION - End Google Tag Manager (noscript) -->
        <!-- SECTION - INITIALIZERS -->
        <script src="../initializers/fire-color-inits.ts"></script>
        <script src="../scripts/globals/on-scroll-anim.ts"></script>
        <!-- !SECTION - INITIALIZERS -->
        <!-- NAVBAR -->
        <Navbar siteNavigators={siteNavigators} />
        <!-- MAIN -->
        <main>
            <!-- PAGE CONTENT -->
            <slot />
        </main>
        <!-- FOOTER -->
        <Footer siteNavigators={siteNavigators} />
    </body>
    <!-- !SECTION - BODY -->
</html>
